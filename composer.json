{
    "name": "windwalker/core",
    "description": "Next generation PHP framework.",
    "homepage": "https://github.com/windwalker-io/core",
    "license": "MIT",
    "minimum-stability": "beta",
    "require": {
        "php": ">=8.4.6",
        "ext-json": "*",
        "laravel/serializable-closure": "^2.0",
        "psr/clock": "^1.0",
        "fakerphp/faker": "^1.0",
        "fig/link-util": "^1.2",
        "filp/whoops": "^2.1",
        "asika/agent": "^2.7",
        "monolog/monolog": "^2.0||^3.0",
        "nikic/fast-route": "^1.0",
        "nikic/php-parser": "^4.10||^5.0",
        "stecman/symfony-console-completion": "^0.13.0||^0.14.0||^0.15.0||^v0.16.0",
        "symfony/console": "^6.0||^7.0||^8.0",
        "symfony/lock": "^6.0||^7.0||^8.0",
        "symfony/dotenv": "^6.0||^7.0||^8.0",
        "symfony/event-dispatcher-contracts": "^2.0||^3.0",
        "symfony/options-resolver": "^6.0||^7.0||^8.0",
        "symfony/polyfill-php85": "^1.0",
        "symfony/process": "^6.0||^7.0||^8.0",
        "symfony/stopwatch": "^6.0||^7.0||^8.0",
        "webmozart/glob": "^4.0",
        "windwalker/attributes": "^4.0",
        "windwalker/cache": "^4.0",
        "windwalker/crypt": "^4.0",
        "windwalker/data": "^4.0",
        "windwalker/di": "^4.0",
        "windwalker/environment": "^4.0",
        "windwalker/event": "^4.0",
        "windwalker/filesystem": "^4.0",
        "windwalker/filter": "^4.0",
        "windwalker/http": "^4.0",
        "windwalker/test": "^4.0",
        "composer/semver": "^3.4",
        "whichbrowser/parser": "^2.1",
        "asika/object-metadata": "^1.0",
        "psy/psysh": "^0.12.22",
        "symfony/polyfill-time": "^1.42"
    },
    "require-dev": {
        "windwalker/framework": "4.x-dev",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.4",
        "symfony/mailer": "^8.1",
        "dragonmantank/cron-expression": "^3.6",
        "tijsverkoyen/css-to-inline-styles": "^2.4",
        "mikey179/vfsstream": "^1.6"
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "bash bin/php-cs-fixer check --diff",
        "cs-fix": "bash bin/php-cs-fixer fix",
        "prepare-hooks": "git config core.hooksPath .githooks",
        "remove-hooks": "git config --local --unset core.hooksPath"
    },
    "suggest": {
        "dragonmantank/cron-expression": "Install ^3.0 to support schedule runner.",
        "symfony/mailer": "Install it to send mail.",
        "tijsverkoyen/css-to-inline-styles": "Install ~2.0 if you want to use mail css inliner."
    },
    "archive": {
        "exclude": [
            ".github",
            "assets",
            "tests"
        ]
    },
    "autoload" : {
        "psr-4" : {
            "Windwalker\\" : "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Windwalker\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.6"
        }
    },
    "extra": {
        "windwalker": {
            "packages": [
                "Windwalker\\Debugger\\DebuggerPackage"
            ]
        },
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
