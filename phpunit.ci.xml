<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    bootstrap="tests/bootstrap.app.php"
    colors="false"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.2/phpunit.xsd"
    cacheDirectory=".phpunit.cache"
>
	<php>
		<ini name="error_reporting" value="-1" />

        <!--
            Database DSN - local installation
            These are standard PDO DSN strings, ready to pass as the first argument
            to `new PDO($dsn, $user, $password)`. User/password are NOT part of the
            DSN itself - supply them separately. The `prefix` (table prefix) is also
            configured separately in your database config, not in the DSN.
            Uncomment exactly one (matching your local database) and adjust it.
        -->
        <env name="WINDWALKER_TEST_DB_DSN"  value="pdo_mysql:host=127.0.0.1;dbname=windwalker_test_core;user=root;password=;prefix=ww_" />
        <!--<env name="WINDWALKER_TEST_DB_DSN"  value="host=127.0.0.1;dbname=windwalker_test_core;user=postgres;password=ut1234;prefix=ww_" />-->
        <!--<env name="WINDWALKER_TEST_DB_DSN" value="host=127.0.0.1;port=1521;dbname=FREEPDB1;user=windwalker;password=ut1234;prefix=ww_" />-->
        <!--<env name="WINDWALKER_TEST_DB_DSN" value="host=127.0.0.1;port=1433;dbname=windwalker_test_core;user=sa;password=Ut1234!pass;prefix=ww_" />-->
        <!--<env name="WINDWALKER_TEST_DB_DSN" value="dbname=tmp/test.db;prefix=ww_" />-->

        <!-- Enable Redis / Memcached / Swoole tests (requires running services) -->
        <!--<env name="REDIS_ENABLED" value="1" />-->
        <!--<env name="MEMCACHED_ENABLED" value="1" />-->
        <!--<env name="SQS_ENABLED" value="1" />-->
        <!--<env name="SWOOLE_ENABLED" value="1" />-->
	</php>

	<testsuites>
		<testsuite name="Unit">
			<directory>tests</directory>
		</testsuite>
	</testsuites>

    <!-- Code Coverage -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
