<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    bootstrap="tests/bootstrap.app.php"
    colors="false"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.2/phpunit.xsd"
    cacheDirectory=".phpunit.cache"
>
	<php>
		<ini name="error_reporting" value="-1" />
        <env name="WINDWALKER_TEST_APP_ROOT" value="../../.." />

        <!--
            Default database DSN, used by general tests. The prefix before ':' selects the
            platform: pdo_mysql, pdo_pgsql, pdo_sqlsrv, pdo_oracle or pdo_sqlite.
            An environment variable with the same name takes precedence over this value.
            Start database servers in the background first (for example `docker compose up -d`).
        -->
        <!--<env name="WINDWALKER_TEST_DB_DSN" value="pdo_mysql:host=127.0.0.1;port=3306;dbname=windwalker_test_core;user=root;password=ut1234;prefix=ww_" />-->

        <!--
            Per-database DSNs. Uncomment one and copy its value into WINDWALKER_TEST_DB_DSN
            above to run general tests against that database.
        -->
        <!--<env name="WINDWALKER_TEST_DB_DSN_MYSQL" value="pdo_mysql:host=127.0.0.1;port=3306;dbname=windwalker_test_core;user=root;password=;prefix=ww_" />-->
        <!--<env name="WINDWALKER_TEST_DB_DSN_PGSQL" value="pdo_pgsql:host=127.0.0.1;port=5432;dbname=windwalker_test_core;user=postgres;password=ut1234;prefix=ww_" />-->
        <!--<env name="WINDWALKER_TEST_DB_DSN_SQLSRV" value="pdo_sqlsrv:host=127.0.0.1;port=1433;dbname=windwalker_test_core;user=sa;password=Ut1234!pass;prefix=ww_" />-->
        <!--<env name="WINDWALKER_TEST_DB_DSN_ORACLE" value="pdo_oracle:host=127.0.0.1;port=1521;dbname=FREEPDB1;user=system;password=ut1234;prefix=ww_" />-->
        <!--<env name="WINDWALKER_TEST_DB_DSN_SQLITE" value="pdo_sqlite:dbname=tmp/test.db;prefix=ww_" />-->

        <!--
            Legacy Oracle exp/imp via the container (optional). Uncomment to use the
            windwalker_oracle container; leave commented when exp/imp exist on PATH.
        -->
        <!--<env name="ORACLE_EXP_BINARY" value="bin/oracle-docker-exp" />-->
        <!--<env name="ORACLE_IMP_BINARY" value="bin/oracle-docker-imp" />-->

        <!-- Enable Redis / Memcached / Swoole tests (requires running services) -->
        <!--<env name="REDIS_ENABLED" value="1" />-->
        <!--<env name="MEMCACHED_ENABLED" value="1" />-->
        <!--<env name="SQS_ENABLED" value="1" />-->
        <!--<env name="SWOOLE_ENABLED" value="1" />-->
	</php>

	<testsuites>
		<testsuite name="Unit">
			<directory>tests</directory>
		</testsuite>
	</testsuites>

    <!-- Code Coverage -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
